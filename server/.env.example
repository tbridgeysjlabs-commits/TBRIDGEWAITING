# 프론트 공개 URL (알림톡 링크 + CORS 허용 Origin)
# Render 예: https://your-frontend.onrender.com
# 여러 개면 CLIENT_ORIGINS=url1,url2
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGINS=https://front.onrender.com,https://custom-domain.com
# API 공개 URL (나이스페이 콜백 등)
API_PUBLIC_URL=http://localhost:4000

# Socket.io — 현재 단일 인스턴스(in-memory). 다중 인스턴스 시 REDIS_URL + Adapter 추가
# REDIS_URL=
# NicePay (클래식 인증결제: MID + MerchantKey)
