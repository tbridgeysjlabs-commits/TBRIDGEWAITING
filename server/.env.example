NICEPAY_MERCHANT_KEY=
NICEPAY_CANCEL_PWD=
NICEPAY_BUYER_EMAIL=test@abc.com
NICEPAY_ALLOW_MOCK=0

# ─── 뿌리오(ppurio.com) 알림톡 API ─────────────────────────────
# 연동 문서: 뿌리오 로그인 → [문자,카카오톡 연동 > 이용안내/연동신청관리]
# ※ 비즈뿌리오(api.bizppurio.com) 는 사용하지 않습니다.
#
# [사람 확인 필요]
# - 발신프로필/8개 템플릿이 뿌리오 계정에 승인 등록됐는지
# - 연동신청관리에 Render 운영 IP 등록 여부
# - Render Environment 에도 ACCOUNT / AUTH_KEY / SENDER_PROFILE 등록
#
# 필수 3개만 있으면 실발송 (없으면 MOCK)
# PPURIO_MOCK=1 또는 PPURIO_ENABLED=0 이면 강제 MOCK
PPURIO_ACCOUNT="tbridge"
